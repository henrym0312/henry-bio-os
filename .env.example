# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-example.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Oura Cloud API v2 OAuth2 Application Credentials
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret

# Random high-entropy string for Oura webhook verification
OURA_WEBHOOK_VERIFICATION_TOKEN=your_webhook_verification_token

# Bearer token protecting ingestion, backfill, analytics, and management API routes
API_SECRET=your_strong_api_secret

# Google Gemini API Key for automated diagnostic briefings
GEMINI_API_KEY=your_gemini_api_key

# Public base URL for OAuth callbacks and webhook endpoints
NEXT_PUBLIC_APP_URL=https://bio.henrymilner.uk
